QWidget#rsdm {
    background-color: #f4f7fb;
    color: #14213d;
    font-family: "DejaVu Sans";
    font-size: 12px;
}

QGroupBox {
    background-color: #ffffff;
    border: 1px solid #d9e2ef;
    border-radius: 7px;
    margin-top: 18px;
    padding-top: 7px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 5px;
    color: #14213d;
    background-color: transparent;
}

QGroupBox#imageGb,
QGroupBox#pointEditorGb,
QGroupBox#controlPanelGb,
QGroupBox#measurementGb {
    background-color: #f8fafc;
    border-color: #cfd9e7;
    font-size: 16px;
}

QGroupBox#groupBox_7,
QGroupBox#groupBox_4,
QGroupBox#groupBox_10,
QGroupBox#groupBox_8,
QGroupBox#areaScanGb,
QGroupBox#groupBox_5,
QGroupBox#groupBox_9,
QGroupBox#groupBox_11,
QGroupBox#distanceGb {
    font-size: 12px;
}

QGroupBox#groupBox_7::title,
QGroupBox#groupBox_4::title,
QGroupBox#groupBox_10::title,
QGroupBox#groupBox_8::title,
QGroupBox#areaScanGb::title,
QGroupBox#groupBox_5::title,
QGroupBox#groupBox_9::title,
QGroupBox#groupBox_11::title,
QGroupBox#distanceGb::title {
    font-size: 14px;
    font-weight: 700;
}

QPushButton {
    min-height: 27px;
    padding: 2px 10px;
    color: #1e2b44;
    background-color: #ffffff;
    border: 1px solid #b9c7da;
    border-radius: 5px;
    font-weight: 500;
}

QPushButton:hover {
    color: #1261a6;
    background-color: #f0f7ff;
    border-color: #4c9be8;
}

QPushButton:pressed {
    color: #ffffff;
    background-color: #1769aa;
    border-color: #1769aa;
}

QPushButton:disabled {
    color: #93a1b4;
    background-color: #eef2f7;
    border-color: #d8e0ea;
}

QPushButton#seqCreatePb,
QPushButton#areaCreatePb,
QPushButton#pbScanPoints,
QPushButton#pbStartLogging {
    color: #ffffff;
    background-color: #1976d2;
    border-color: #1976d2;
    font-weight: 600;
}

QPushButton#seqCreatePb:hover,
QPushButton#areaCreatePb:hover,
QPushButton#pbScanPoints:hover,
QPushButton#pbStartLogging:hover {
    background-color: #1565c0;
    border-color: #1565c0;
}

QPushButton#pbStopLogging {
    color: #c62828;
    background-color: #ffffff;
    border-color: #ef5350;
}

QPushButton#pbStopLogging:hover {
    color: #ffffff;
    background-color: #d32f2f;
    border-color: #d32f2f;
}

QPushButton#pbEmergencyStop {
    min-height: 38px;
    color: #ffffff;
    background-color: #d71920;
    border: 1px solid #b81218;
    border-radius: 5px;
    font-size: 14px;
    font-weight: 700;
}

QPushButton#pbEmergencyStop:hover {
    background-color: #bd151b;
}

QPushButton#pbEmergencyStop:pressed {
    background-color: #941016;
}

QPushButton#btnUp,
QPushButton#btnDown,
QPushButton#btnLeft,
QPushButton#btnRight {
    min-width: 43px;
    min-height: 31px;
    padding: 0;
    font-size: 18px;
    font-weight: 700;
}

QPushButton#areaSelectAPb,
QPushButton#areaSelectBPb,
QPushButton#areaSelectCPb,
QPushButton#areaSelectDPb {
    min-height: 25px;
    padding: 1px 3px;
    font-size: 10px;
}

QLineEdit,
QComboBox,
QSpinBox {
    min-height: 27px;
    padding: 1px 7px;
    color: #14213d;
    background-color: #ffffff;
    border: 1px solid #bdcada;
    border-radius: 4px;
    selection-background-color: #1976d2;
}

QLineEdit:focus,
QComboBox:focus,
QSpinBox:focus {
    border: 1px solid #1976d2;
}

QSpinBox {
    padding-right: 22px;
}

QSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 20px;
    background-color: #eef4fb;
    border-left: 1px solid #bdcada;
    border-bottom: 1px solid #d9e2ef;
    border-top-right-radius: 4px;
}

QSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 20px;
    background-color: #eef4fb;
    border-left: 1px solid #bdcada;
    border-top: 1px solid #d9e2ef;
    border-bottom-right-radius: 4px;
}

QSpinBox::up-button:hover,
QSpinBox::down-button:hover {
    background-color: #dcecff;
}

QSpinBox::up-arrow {
    image: url(:/qt-project.org/styles/commonstyle/images/up-16.png);
    width: 10px;
    height: 10px;
}

QSpinBox::down-arrow {
    image: url(:/qt-project.org/styles/commonstyle/images/down-16.png);
    width: 10px;
    height: 10px;
}

QLineEdit:read-only {
    background-color: #f8fafc;
    color: #24344f;
}

QLineEdit#yawLe,
QLineEdit#pitchLe,
QLineEdit#rollLe,
QLineEdit#tmpLe {
    color: #14213d;
    background-color: #f8fafc;
    font-family: "DejaVu Sans";
    font-size: 12px;
    font-weight: 600;
}

QTableWidget {
    color: #1e2b44;
    background-color: #ffffff;
    alternate-background-color: #f7faff;
    border: 1px solid #cbd6e4;
    border-radius: 4px;
    gridline-color: #e1e7ef;
    selection-color: #ffffff;
    selection-background-color: #1976d2;
}

QHeaderView::section {
    min-height: 28px;
    padding: 3px 5px;
    color: #263752;
    background-color: #edf3fa;
    border: 0;
    border-right: 1px solid #d5dfeb;
    border-bottom: 1px solid #cbd6e4;
    font-size: 13px;
    font-weight: 600;
}

QCheckBox {
    spacing: 7px;
    color: #27364e;
}

QGroupBox#distanceGb QCheckBox,
QGroupBox#distanceGb QLabel {
    spacing: 4px;
    font-size: 11px;
}

QCheckBox::indicator {
    width: 15px;
    height: 15px;
}

QLabel#areaTotalLabel,
QLabel#seqTotalLabel {
    color: #42526b;
    font-weight: 600;
}

QLabel#imageLabel {
    background-color: #000000;
    border: 1px solid #111827;
    border-radius: 5px;
}
